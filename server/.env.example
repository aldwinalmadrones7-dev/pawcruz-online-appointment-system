# Copy this file to .env (same folder) and fill in your own values. Never commit .env.

# Port the API listens on. The React app expects http://localhost:5000/api.
PORT=5000
NODE_ENV=development

# MongoDB connection string — pick ONE:
#   MongoDB Atlas (cloud): Atlas > your cluster > Connect > Drivers, then add the database name "pawcruz"
#     MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/pawcruz?retryWrites=true&w=majority
#   Local MongoDB Community Server:
#     MONGODB_URI=mongodb://127.0.0.1:27017/pawcruz
MONGODB_URI=mongodb://127.0.0.1:27017/pawcruz

# Optional: DNS servers for Atlas lookups if you get "querySrv ECONNREFUSED" (comma-separated).
# DNS_SERVERS=8.8.8.8,1.1.1.1

# Secret used to sign login tokens (JWT). Use a long random string (at least 32 characters).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=7d

# Address of the React app (allowed by CORS). Separate several with commas.
CLIENT_URL=http://localhost:5173

# Lets veterinarians use "Reset demo data" on the dashboard. Set to false for a real clinic.
ALLOW_DEMO_RESET=true

# Code a veterinarian must type on the Create account page to open a vet account.
# Change it for a real clinic. If it is missing, development uses PAWCRUZ-VET and
# production keeps vet sign-up closed.
VET_SIGNUP_CODE=PAWCRUZ-VET
