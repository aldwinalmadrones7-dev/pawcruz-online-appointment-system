# Optional: copy this file to .env only if the API is NOT at http://localhost:5000/api.
# Used by src/api/axiosClient.js (Vite only exposes variables that start with VITE_).
VITE_API_URL=http://localhost:5000/api
# Copy this file to .env (same folder) and fill in your own values. Never commit .env.

# Port the API listens on. The React app expects http://localhost:5000/api.
PORT=5000
NODE_ENV=development

# MongoDB connection string — pick ONE:
#   MongoDB Atlas (cloud): Atlas > your cluster > Connect > Drivers, then add the database name "pawcruz"
#     MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/pawcruz?retryWrites=true&w=majority
#   Local MongoDB Community Server:
#     MONGODB_URI=mongodb://127.0.0.1:27017/pawcruz
MONGODB_URI=mongodb://patty_admin:VI18M5rVaAPjXBob@ac-dribgpi-shard-00-00.a4azswv.mongodb.net:27017,ac-dribgpi-shard-00-01.a4azswv.mongodb.net:27017,ac-dribgpi-shard-00-02.a4azswv.mongodb.net:27017/?ssl=true&replicaSet=atlas-5zrri8-shard-0&authSource=admin&appName=Cluster0
# VI18M5rVaAPjXBob


# Secret used to sign login tokens (JWT). Use a long random string (at least 32 characters).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=f0c6c6df3853620661ed3c95fc38817654177af2330c741853e8d3884c7d88024b7f7aaf6cfbc96d97350c31e56f52ac
JWT_EXPIRES_IN=7d

# Address of the React app (allowed by CORS). Separate several with commas.
CLIENT_URL=http://localhost:5173

# Lets admins use "Reset demo data" on the dashboard. Set to false for a real clinic.
ALLOW_DEMO_RESET=true