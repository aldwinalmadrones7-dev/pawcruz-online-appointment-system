# Copy this file to .env (same folder). Never put passwords or secrets here — this file is committed.
# Used by src/api/axiosClient.js (Vite only exposes variables that start with VITE_).
#   Local development:  VITE_API_URL=http://localhost:5000/api
#   Deployed site:      set VITE_API_URL in Vercel > Project > Settings > Environment Variables
#                       to your hosted API, e.g. https://pawcruz-api.onrender.com/api
VITE_API_URL=http://localhost:5000/api
